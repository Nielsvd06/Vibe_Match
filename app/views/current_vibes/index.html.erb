<div class="container mt-5" style="max-width: 700px;">

  <h3 class="text-center mb-4">Create Your Vibe</h3>

  <div class="card shadow-sm">
    <div class="card-body" style="height: 400px; overflow-y: auto;">

      <% @chat.messages.each do |message| %>
        <div class="mb-3 <%= message.role == 'user' ? 'text-end' : 'text-start' %>">

          <div class="d-inline-block p-3 rounded
            <%= message.role == 'assistant' ? 'bg-light' : 'bg-primary text-white' %>">

            <%= message.content %>

          </div>

        </div>
      <% end %>

    </div>
  </div>

  <div class="mt-3">
    <%= form_with model: [@chat, @message], local: true do |f| %>
      <div class="input-group">

        <%= f.text_field :content,
          class: "form-control",
          placeholder: "Type your message..." %>

        <button class="btn btn-dark">
          Send
        </button>

      </div>
    <% end %>
  </div>

</div>

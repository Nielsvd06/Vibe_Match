<div class="container mt-5" style="max-width: 720px;">

  <h3 class="text-center mb-4">Find Your Vibe</h3>

  <div class="card shadow-sm">
    <div class="card-body" style="height: 420px; overflow-y: auto;">

      <% @current_vibe.messages.each do |message| %>

        <div class="mb-3 d-flex <%= message.role == "user" ? "justify-content-end" : "justify-content-start" %>">

          <div class="p-3 rounded
              <%= message.role == "assistant" ? "bg-light" : "bg-primary text-white" %>"
              style="max-width: 75%;">

            <%= message.content %>

          </div>

        </div>

      <% end %>

    </div>
  </div>

  <div class="mt-3">
    <%= form_with model: [@current_vibe, @message], local: true do |f| %>

      <div class="input-group">

        <%= f.text_field :content,
            class: "form-control",
            placeholder: "Tell me about your current vibe..." %>

        <button class="btn btn-dark">
          Send
        </button>

      </div>

    <% end %>
  </div>

</div>

<div class="container py-5">

  <!-- H1 above Chat Box -->
  <h1 class="display-3 fw-bold text-center mb-5" style="color: rgb(243, 196, 89);">
    What's your vibe right now?
  </h1>

  <div class="card shadow-lg" style="background-color: #1E3A6B; height: 70vh; display: flex; flex-direction: column; border-radius: 20px;">

    <!-- Messages area -->
    <div class="card-body overflow-auto p-5" id="messages" style="background-color: rgb(16, 32, 56);">
      <% @current_vibe.messages.each do |message| %>
        <% if message.role == "user" %>
          <div class="d-flex justify-content-end mb-4">
            <div class="p-4 rounded-4 shadow-sm" style="max-width: 70%; background-color: rgb(216, 106, 54); color: white;">
              <%= message.content %>
            </div>
          </div>
        <% else %>
          <div class="d-flex justify-content-start mb-4">
            <div class="p-4 rounded-4 shadow-sm" style="max-width: 70%; background-color: #2A4A7E; color: #FFF7E6;">
              <%= message.content %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- chat box -->
    <div class="card-footer p-4" style="background-color: rgb(16, 32, 56); border-top: none;">
      <%= simple_form_for [@current_vibe, @message] do |f| %>
        <div class="message-form-control form-group position-relative">
          <%= f.input :content,
                      label: false,
                      required: true,
                      input_html: {
                        class: "form-control form-control-lg",
                        placeholder: "Type your answer here...",
                        style: "border-radius: 50px; background-color: #2A4A7E; color: white;"
                      } %>
          <%= f.button :submit, "Send →",
                       class: "btn position-absolute",
                       style: "background-color: rgb(243, 196, 89); color: rgb(8, 18, 35); border-radius: 50px;" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- recommendations button -->
  <div class="text-center mt-4">
    <%= button_to "Give me 3 Movie Recommendations",
                  { controller: "recommendations", action: "create", current_vibe_id: @current_vibe.id },
                  method: :post,
                  class: "btn btn-lg px-5 py-3 fw-bold",
                  style: "background-color: rgb(243, 196, 89); color: rgb(8, 18, 35); width: 100%;" %>
  </div>
</div>

<!-- Auto-scroll -->
<script>
  const messagesDiv = document.getElementById("messages");
  messagesDiv.scrollTop = messagesDiv.scrollHeight;
</script>

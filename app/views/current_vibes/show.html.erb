<h1 class="text-center my-5 display-4">VIBE MATCH</h1>

<div class="container">
  <div class="card shadow-lg" style="height: 70vh; display: flex; flex-direction: column;">

    <!-- Messages area -->
    <div class="card-body overflow-auto p-4" id="messages">
      <% @current_vibe.messages.each do |message| %>
        <div class="mb-3">
          <% if message.role == "user" %>
            <div class="d-flex justify-content-end">
              <div class="bg-primary text-white p-3 rounded-3" style="max-width: 70%;">
                <strong>You</strong><br>
                <%= message.content %>
              </div>
            </div>
          <% else %>
            <div class="d-flex justify-content-start">
              <div class="bg-light p-3 rounded-3" style="max-width: 70%;">
                <strong>AI</strong><br>
                <%= message.content %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Send box – exactly like the school search bar you showed me -->
    <div class="card-footer bg-white p-3">
      <div id="new_message_container">
        <%= simple_form_for [@current_vibe, @message] do |f| %>
          <div class="message-form-control form-group position-relative">
            <%= f.input :content,
                        label: false,
                        required: true,
                        input_html: { class: "form-control form-control-lg",
                                      placeholder: "Type your answer here..." } %>
            <%= f.button :submit, "ASK LLM →", class: "btn btn-primary position-absolute" %>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>

<!-- Auto-scroll to newest message -->
<script>
  const messagesDiv = document.getElementById("messages");
  messagesDiv.scrollTop = messagesDiv.scrollHeight;
</script>
